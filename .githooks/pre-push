#!/usr/bin/env bash
# ==============================================================================
# Git pre-push hook for makelib-py
# Enforces:
#  1. Disallows direct pushes to 'main' (forces branch + PR workflow).
#  2. Executes 'make check-all' before pushing feature branches.
# ==============================================================================

set -euo pipefail

PROTECTED_BRANCH="main"
CURRENT_BRANCH=$(git symbolic-ref --short HEAD 2>/dev/null || echo "")

# Prevent direct pushes to main branch
if [ "$CURRENT_BRANCH" = "$PROTECTED_BRANCH" ]; then
    echo "========================================================================"
    echo "ERROR: Direct push to '$PROTECTED_BRANCH' is prohibited!"
    echo "Branch protection policy requires creating a feature branch and a Pull Request."
    echo "  1. git checkout -b feature/my-feature-name"
    echo "  2. git push origin feature/my-feature-name"
    echo "  3. Open a Pull Request against $PROTECTED_BRANCH"
    echo "========================================================================"
    exit 1
fi

echo "==> Running local quality verification (make check-all) before pushing..."
if ! make check-all; then
    echo "========================================================================"
    echo "ERROR: 'make check-all' failed. Fix errors before pushing to remote."
    echo "========================================================================"
    exit 1
fi

echo "==> Pre-push quality checks passed successfully."
exit 0
