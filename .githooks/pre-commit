#!/usr/bin/env bash
# ==============================================================================
# Git pre-commit hook for makelib-py
# Enforces:
#  1. Disallows committing directly to 'main' (enforces feature branch workflow).
#  2. Validates branch name classification policy before any commit is recorded.
# ==============================================================================

set -euo pipefail

PROTECTED_BRANCH="main"
CURRENT_BRANCH=$(git symbolic-ref --short HEAD 2>/dev/null || echo "")

# If in detached HEAD state (e.g. rebase, bisect, cherry-pick), allow
if [ -z "$CURRENT_BRANCH" ]; then
    exit 0
fi

# 1. Prohibit committing directly to main branch
if [ "$CURRENT_BRANCH" = "$PROTECTED_BRANCH" ]; then
    echo "========================================================================"
    echo "ERROR: Commits directly to '$PROTECTED_BRANCH' are prohibited!"
    echo "Branch protection policy requires committing to a classified feature branch:"
    echo "  1. git checkout -b feat/my-feature-name"
    echo "  2. git commit -m \"feat: describe your change\""
    echo "  3. Open a Pull Request targeting $PROTECTED_BRANCH"
    echo "========================================================================"
    exit 1
fi

# 2. Enforce strict branch naming classification
BRANCH_REGEX="^(feat|feature|fix|patch|major|breaking|docs|chore|refactor|ci)/[a-z0-9._-]+$"
if [[ ! "$CURRENT_BRANCH" =~ $BRANCH_REGEX ]]; then
    echo "========================================================================"
    echo "ERROR: Branch '$CURRENT_BRANCH' violates branch naming policy!"
    echo "Cannot commit to unclassified branch. Branch names must start with:"
    echo "  - major/<name> or breaking/<name> (Breaking changes -> MAJOR bump)"
    echo "  - feat/<name>  or feature/<name>  (New features    -> MINOR bump)"
    echo "  - fix/<name>   or patch/<name>    (Bug fixes       -> PATCH bump)"
    echo "  - docs/<name>  or chore/<name>    (Documentation / chore -> PATCH)"
    echo "  - refactor/<name> or ci/<name>    (Refactor / CI updates -> PATCH)"
    echo ""
    echo "Allowed characters after prefix: lowercase alphanumeric, dashes, dots, underscores."
    echo ""
    echo "To rename your current branch to a valid name:"
    echo "  git branch -m feat/$(echo "$CURRENT_BRANCH" | tr '[:upper:]' '[:lower:]' | tr -cs 'a-z0-9._-' '-')"
    echo "========================================================================"
    exit 1
fi

exit 0
